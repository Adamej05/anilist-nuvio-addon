{
  "name": "anilist-nuvio-addon",
  "version": "1.0.0",
  "description": "Stremio/Nuvio addon: AniList anime by year and season, plus AniList user lists",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node out/dev-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:mapping": "node scripts/build-mapping.ts out/mapping.json"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
